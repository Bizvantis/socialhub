# HTTPS for a single self-hosted VM (docker-compose.oracle.yml). The nginx image fills in
# ${SITE_DOMAIN} at start-up (envsubst); Nginx's own $variables are left untouched.
#   https://SITE_DOMAIN        landing site, React app (/app/), API (/api/)
#   https://media.SITE_DOMAIN  S3 (SeaweedFS) for pre-signed uploads/downloads and HLS segments

upstream gateway {
    server api-gateway:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name ${SITE_DOMAIN} media.${SITE_DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/snippets/socialhub-locations.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name media.${SITE_DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # Uploads go straight from the browser to S3: allow large videos, stream them through.
    client_max_body_size 2100m;
    proxy_request_buffering off;
    proxy_buffering off;

    location / {
        proxy_pass http://s3:8333;
        proxy_http_version 1.1;
        proxy_set_header Host $host;          # SigV4 signatures cover the Host header
        proxy_set_header Connection "";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
