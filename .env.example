MYSQL_ROOT_PASSWORD=change_me
REDIS_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_random_string
AWS_REGION=ap-south-1
S3_BUCKET=change_me

# --- Object storage (media-service) ---
# Local dev uses SeaweedFS from docker-compose with the defaults below; nothing to set.
# Production (AWS S3): set MEDIA_BUCKET, leave S3_ENDPOINT/S3_PUBLIC_ENDPOINT/S3_ACCESS_KEY empty
# so the SDK uses the EC2 instance role, and set S3_PATH_STYLE=false, S3_CREATE_BUCKET=false.
# MEDIA_BUCKET=socialhub-media
# S3_ENDPOINT=http://localhost:8333
# S3_PUBLIC_ENDPOINT=http://localhost:8333
# S3_ACCESS_KEY=socialhub
# S3_SECRET_KEY=socialhub_dev_s3_secret

# --- Kafka ---
# KAFKA_BOOTSTRAP=localhost:9092
